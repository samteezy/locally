{
  "transport": {
    "mode": "stdio",
    "port": 3000,
    "host": "127.0.0.1"
  },
  "default": {
    "baseUrl": "http://localhost:11434/v1",
    "model": "qwen3:8b",
    "apiKey": "",
    "maxTokens": 4096,
    "timeout": 600
  },
  "agents": {
    "coder": {
      "model": "qwen3:14b"
    },
    "summarizer": {
      "baseUrl": "https://api.openai.com/v1",
      "model": "gpt-4o-mini",
      "apiKey": "sk-..."
    }
  },
  "tools": {
    "explore": { "agent": "summarizer" },
    "run": { "agent": "coder" }
  },
  "ignorePatterns": ["*.log", "tmp"],
  "allowedRoots": ["/abs/path/to/project", "/abs/path/to/another"],
  "knowledge": {
    "enabled": false,
    "watch": ["/abs/path/to/notes"],
    "storePath": "/abs/path/to/knowledge.db",
    "fileTypes": ["md", "markdown", "txt"],
    "embeddings": {
      "baseUrl": "http://localhost:11434/v1",
      "model": "nomic-embed-text",
      "apiKey": "",
      "dimensions": 768,
      "batchSize": 32,
      "timeout": 600
    },
    "chunk": { "maxChars": 1000, "overlap": 150 }
  }
}
